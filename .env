# Configuración única del MVP. Este archivo está versionado.
# Todo se ejecuta con Docker Compose: docker compose up --build
# Las credenciales son locales y de un solo entorno. No usar en producción.

# --- PostgreSQL ---
POSTGRES_DB=veterinary
POSTGRES_USER=veterinary
POSTGRES_PASSWORD=CAMBIAR_ESTE_VALOR

# --- Backend ---
ASPNETCORE_ENVIRONMENT=Development
Cors__AllowedOrigin=http://localhost:5173
Jwt__Key=CAMBIAR_POR_CLAVE_LARGA_DE_AL_MENOS_32_CARACTERES
BasicAuth__Username=veterinaria-web
BasicAuth__Password=eDVVDESZ5JuhVwGfaCC9c8oro0fhf6KM

# --- Reglas de negocio y bloqueo ---
BusinessRules__SlotCapacity=4
BusinessRules__TimeZone=America/Bogota
Lockout__MaxFailedAttempts=3
Lockout__LockoutMinutes=2

# --- Administrador semilla ---
# ADVERTENCIA: Admin123! es la contraseña por defecto del único entorno (riesgo aceptado).
SEED_ADMIN_EMAIL=admin@veterinaria.local
SEED_ADMIN_PASSWORD=Admin123!
SEED_ADMIN_IDENTIFICATION=0000000000
SEED_ADMIN_NAME=Administrador

# --- Puertos y frontend ---
BACKEND_PORT=5000
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:5000

# ConnectionStrings__Veterinary NO se define aquí: docker-compose.yml la construye
# a partir de POSTGRES_* con el host "postgres".
